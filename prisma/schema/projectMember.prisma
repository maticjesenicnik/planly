enum ProjectRole {
  ADMIN
  PROJECT_MANAGER
  PRODUCT_OWNER
  SCRUM_MASTER
  DEVELOPER
  QUALITY_ASSURANCE
  DESIGNER
  VIEWER
  CONTRIBUTOR
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(CONTRIBUTOR)

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}
